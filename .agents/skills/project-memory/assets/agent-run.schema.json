{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/project-memory/v1/agent-run.schema.json",
  "title": "agent-run",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "run_id",
    "goal_id",
    "task",
    "agent",
    "model",
    "git",
    "status",
    "created_at",
    "updated_at",
    "revision"
  ],
  "properties": {
    "schema_version": {
      "const": "1.2"
    },
    "kind": {
      "const": "agent_run"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "goal_id": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "agent": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "enum": [
        "executor",
        "verifier"
      ]
    },
    "model": {
      "type": "object",
      "required": [
        "provider",
        "id"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "type": "string",
          "description": "Legacy field kept for reading old records; new writers must not emit it."
        }
      },
      "additionalProperties": true
    },
    "tool": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "git": {
      "type": "object",
      "required": [
        "base_sha"
      ],
      "properties": {
        "base_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{40}$"
        },
        "head_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{40}$"
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "authorization": {
      "type": "string"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "paused",
        "submitted",
        "verified",
        "failed",
        "cancelled",
        "superseded"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "ended_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifacts": {
      "type": "array"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "handoff": {
      "type": [
        "string",
        "null"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": true
}
