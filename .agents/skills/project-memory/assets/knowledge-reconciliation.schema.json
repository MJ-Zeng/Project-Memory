{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/project-memory/v1/knowledge-reconciliation.schema.json",
  "title": "knowledge-reconciliation",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "generated_at",
    "state",
    "counts",
    "items",
    "summary",
    "goals",
    "recommended_next_actions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.2"
    },
    "kind": {
      "const": "knowledge_reconciliation"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "repo": {
      "type": "string"
    },
    "state": {
      "enum": [
        "clean",
        "needs_attention"
      ]
    },
    "counts": {
      "type": "object",
      "required": [
        "high",
        "medium",
        "low"
      ],
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "code",
          "message",
          "refs",
          "action"
        ],
        "properties": {
          "severity": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "action": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "summary": {
      "type": "object"
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "satisfied"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "satisfied": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    },
    "recommended_next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
