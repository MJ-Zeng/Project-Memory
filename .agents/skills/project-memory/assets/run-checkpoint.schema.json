{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/project-memory/v1/run-checkpoint.schema.json",
  "title": "run-checkpoint",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "run_id",
    "task",
    "head_sha",
    "completed",
    "remaining",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.2"
    },
    "kind": {
      "const": "run_checkpoint"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "goal_id": {
      "type": "string"
    },
    "head_sha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{40}$"
    },
    "completed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "remaining": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "note": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true
}
