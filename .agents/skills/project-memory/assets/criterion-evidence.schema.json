{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/project-memory/v1/criterion-evidence.schema.json",
  "title": "criterion-evidence",
  "type": "object",
  "required": ["criteria"],
  "properties": {
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "criterion_id",
          "goal_id",
          "task_id",
          "criterion_description",
          "target_repository",
          "target_commit_sha",
          "evidence_id",
          "evidence_source",
          "execution_status",
          "coverage_claim",
          "coverage_review_status",
          "independent_verifier",
          "verification_result"
        ],
        "properties": {
          "criterion_id": {"type": "string", "minLength": 1},
          "goal_id": {"type": "string", "minLength": 1},
          "task_id": {"type": "string", "minLength": 1},
          "criterion_description": {"type": "string", "minLength": 1},
          "target_repository": {"type": "string", "minLength": 1},
          "target_commit_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
          "evidence_id": {"type": "string", "minLength": 1},
          "evidence_source": {
            "enum": ["test", "check", "command", "ci", "review"]
          },
          "evidence_command": {"type": "string"},
          "evidence_log": {"type": "string"},
          "evidence_exit_code": {"type": "integer"},
          "evidence_ci_url": {"type": "string"},
          "evidence_ci_status": {"type": "string"},
          "evidence_review_url": {"type": "string"},
          "evidence_review_state": {"type": "string"},
          "execution_status": {
            "enum": ["passed", "failed", "error", "not_run", "unknown"]
          },
          "coverage_claim": {"type": "string", "minLength": 1},
          "coverage_review_status": {
            "enum": ["confirmed", "unconfirmed", "rejected", "not_reviewed"]
          },
          "independent_verifier": {"type": "string", "minLength": 1},
          "verification_result": {
            "enum": ["pass", "fail", "inconclusive"]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
