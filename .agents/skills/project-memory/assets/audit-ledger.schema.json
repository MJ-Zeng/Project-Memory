{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/project-memory/v1/audit-ledger.schema.json",
  "title": "audit-ledger",
  "description": "Execution audit entries (one JSON object per line) and anchor-signed checkpoints. Fields mirror coordination.py; verify samples are stored under evidence/R1/<run>/schema-samples/.",
  "oneOf": [
    {"$ref": "#/$defs/verification_attempt"},
    {"$ref": "#/$defs/audit_checkpoint"}
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "verification_attempt": {
      "type": "object",
      "required": [
        "schema_version",
        "kind",
        "seq",
        "timestamp",
        "prev_hash",
        "entry_hash",
        "outcome",
        "reason"
      ],
      "properties": {
        "schema_version": {"const": "1.3"},
        "kind": {"const": "verification_attempt"},
        "seq": {"type": "integer", "minimum": 1},
        "timestamp": {"type": "string", "format": "date-time"},
        "prev_hash": {
          "description": "Previous entry_hash; 64 zeros for the genesis entry.",
          "$ref": "#/$defs/sha256"
        },
        "entry_hash": {
          "description": "SHA-256 of the canonical entry without entry_hash.",
          "$ref": "#/$defs/sha256"
        },
        "outcome": {"type": "string"},
        "reason": {"type": "string"},
        "goal_id": {"type": "string"},
        "criterion_id": {"type": "string"},
        "evaluation_status": {"type": "string"},
        "no_required_criteria": {"type": "boolean"},
        "blocking": {"type": "array", "items": {"type": "string"}},
        "from_status": {"type": "string"},
        "to_status": {"type": "string"},
        "approved_by": {"type": ["string", "null"]},
        "goal_revision": {"type": "integer"},
        "evidence_kind": {"type": "string"},
        "evidence_ref": {"type": ["string", "null"]},
        "evidence_trust": {"type": "string"},
        "evidence_state": {"type": "string"},
        "verified": {"type": "boolean"},
        "detail": {"type": "string"},
        "verification_id": {"type": "string"},
        "target_run": {"type": "string"},
        "verifier_run": {"type": "string"},
        "standard": {"type": "string"},
        "verdict": {"type": "string"},
        "evidence_level": {"type": "string"},
        "trust_level": {"type": "string"},
        "authority_status": {"type": "string"},
        "authority_trusted": {"type": "boolean"},
        "status": {"type": "string"},
        "mapping_status": {"type": "string"},
        "stale": {"type": "boolean"},
        "worktree_dirty": {"type": "boolean"},
        "tracked_changes": {
          "description": "Raw `git status --porcelain` text captured at verification time.",
          "type": "string"
        },
        "tracked_diff_sha256": {"type": ["string", "null"]},
        "log_content_sha256": {"type": ["string", "null"]},
        "receipt_id": {"type": ["string", "null"]},
        "blocking_defects": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "audit_checkpoint": {
      "type": "object",
      "required": [
        "schema_version",
        "kind",
        "checkpoint_id",
        "goal_id",
        "status",
        "chain_head",
        "chain_length",
        "at",
        "approved_by",
        "evidence_sha256",
        "migration_sha256"
      ],
      "properties": {
        "schema_version": {"const": "1.3"},
        "kind": {"const": "audit_checkpoint"},
        "checkpoint_id": {"type": "string", "minLength": 1},
        "goal_id": {"type": "string", "minLength": 1},
        "status": {"const": "achieved"},
        "chain_head": {"$ref": "#/$defs/sha256"},
        "chain_length": {"type": "integer", "minimum": 1},
        "at": {"type": "string", "format": "date-time"},
        "approved_by": {"type": ["string", "null"]},
        "evidence_sha256": {"$ref": "#/$defs/sha256"},
        "migration_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "authority": {
          "description": "Present in the attached audit/head.json; absent from the unsigned head.request.json. Signature covers the canonical payload excluding this object.",
          "type": "object",
          "required": [
            "status",
            "anchor_id",
            "issuer",
            "algorithm",
            "signed_payload_sha256",
            "signature_b64"
          ],
          "properties": {
            "status": {"const": "trusted"},
            "anchor_id": {"type": ["string", "null"]},
            "issuer": {"type": ["string", "null"]},
            "algorithm": {"type": ["string", "null"]},
            "signed_payload_sha256": {"$ref": "#/$defs/sha256"},
            "signature_b64": {"type": "string", "minLength": 1}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
