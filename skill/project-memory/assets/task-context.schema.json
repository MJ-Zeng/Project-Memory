{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/project-memory/v1/task-context.schema.json",
  "title": "task-context",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "task_id",
    "base_sha",
    "generated_at",
    "retrieved"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "kind": {
      "const": "task_context"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "issue": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string"
    },
    "source": {
      "enum": [
        "github_api",
        "local_task_file",
        "provided_snapshot_unverified"
      ]
    },
    "base_sha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{40}$"
    },
    "vcs": {
      "enum": [
        "git",
        "none"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "retrieved": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "object"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
