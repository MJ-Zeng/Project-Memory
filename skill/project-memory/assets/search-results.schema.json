{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/project-memory/v1/search-results.schema.json",
  "title": "search-results",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "backend",
    "query",
    "results"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "kind": {
      "const": "search_results"
    },
    "backend": {
      "enum": [
        "lexical",
        "semantic"
      ]
    },
    "query": {
      "type": "string",
      "minLength": 1
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "score",
          "excerpt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "excerpt": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": true
}
