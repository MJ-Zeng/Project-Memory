{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/project-memory/v1/agent-handoff.schema.json",
  "title": "agent-handoff",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "task",
    "agent",
    "run_id",
    "base_sha",
    "completed",
    "remaining",
    "status"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.1",
        "1.2"
      ]
    },
    "kind": {
      "const": "agent_handoff"
    },
    "task": {
      "type": [
        "string",
        "integer"
      ],
      "minLength": 1,
      "minimum": 1
    },
    "agent": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "base_sha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{40}$"
    },
    "vcs": {
      "enum": [
        "git",
        "none"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "remaining": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "const": "reported_unverified"
    },
    "goal_id": {
      "type": "string",
      "minLength": 1
    },
    "from_run": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "object",
      "required": [
        "provider",
        "id"
      ],
      "properties": {
        "provider": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "key": {
          "type": "string",
          "description": "Legacy field kept for reading old records; new writers must not emit it."
        }
      }
    },
    "session_id": {
      "type": "string"
    },
    "head_sha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{40}$"
    },
    "commits": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{40}$"
      }
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "command",
          "exit_code"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "exit_code": {
            "type": "integer"
          },
          "log": {
            "type": "string"
          }
        }
      }
    },
    "docs_changed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
