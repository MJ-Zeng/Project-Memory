{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/project-memory/v1/document-draft.schema.json",
  "title": "document-draft",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "path",
    "id",
    "doc_kind",
    "status",
    "promotion_required"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "kind": {
      "const": "document_draft"
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "doc_kind": {
      "enum": [
        "canonical",
        "evidence"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "in_flight",
        "evidence"
      ]
    },
    "promotion_required": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
